---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { mailto, portraitAlt, resumeUrl, site, socials } from '../data/site';

/* Save the photo as src/assets/portrait.jpg (or .png/.webp) and it is picked
   up here, resized and served as AVIF/WebP. With no file the design's
   placeholder frame renders instead, and the build still passes. */
const found = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(found)[0]?.default;

const description =
  'Software and platform engineer at Oris, Kubernetes v1.38 Docs Lead, CNCF Ambassador and AWS Community Builder. Based in Lagos, Nigeria.';

const principles = [
  {
    title: 'Delete the manual step',
    text: 'If someone repeats it every release, it belongs in a make target.',
  },
  {
    title: 'Ship it opt-in',
    text: 'A flag nobody has to set beats a change everybody has to absorb.',
  },
  {
    title: 'Docs are an interface',
    text: 'Generated output is a product surface. Design it like one.',
  },
];
---

<Base title="About" description={description} active="/about/">
  <section class="wrap about">
    <div class="aside">
      {
        portrait ? (
          <Image
            class="portrait"
            src={portrait}
            alt={portraitAlt}
            widths={[280, 340, 680]}
            sizes="(max-width: 900px) 280px, 340px"
          />
        ) : (
          <div class="portrait-frame">
            <span class="mono">[PHOTO]</span>
          </div>
        )
      }

      <div class="contact">
        <div class="mono">Contact</div>
        <a href={mailto}>{site.email}</a>
        {socials.map((social) => <a href={social.href}>{social.handle}</a>)}
        <div class="contact-place">{site.location}</div>
      </div>
    </div>

    <div class="bio">
      <h1 class="about-h1">{site.name}</h1>
      <p class="about-role">Cloud Native Software Engineer — Kubernetes v1.38 Docs Lead</p>

      <div class="prose">
        <p class="lead">
          I am a software and platform engineer at Oris, technical lead on a multi-tenant HR
          platform serving more than ten thousand users, usually on the surfaces where being wrong
          is expensive: payroll correctness under concurrency, tenant isolation, service
          extraction.
        </p>
        <p>
          Before that I moved a payment gateway handling half a million daily transactions onto
          Azure without losing one, and built the pipelines that gave two hundred bank branch
          managers a view of their own branch for the first time.
        </p>
        <p>
          The rest of my time is cloud native open source. I am Docs Lead for the Kubernetes v1.38
          release, I rebuilt the tooling behind the API reference every Kubernetes user reads, and I
          spent an LFX mentorship making Microcks contract tests something you run before you push
          rather than something CI tells you about afterwards. I am a CNCF Ambassador and an AWS
          Community Builder.
        </p>
        <p>
          I trained as a chemical engineer at the University of Benin, which is a longer way round
          to a terminal than most.
        </p>
      </div>

      <div class="principles">
        {
          principles.map((principle, index) => (
            <div class="principle">
              <div class="mono">{String(index + 1).padStart(2, '0')}</div>
              <h2>{principle.title}</h2>
              <p>{principle.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap section hire-section">
    <div class="panel panel-split">
      <div>
        <h2 class="hire-title">Open to new work</h2>
        <p class="hire-dek">
          Software engineering, cloud native platform work, and developer relations. Remote, from
          Lagos.
        </p>
      </div>
      <div class="hire-actions">
        <a class="btn btn-ghost on-panel" href={resumeUrl}>
          Resume
          <Icon name="download" size={14} />
        </a>
        <a class="btn btn-primary" href={mailto}>
          Get in touch
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 80px;
    padding-block: 72px 52px;
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .portrait,
  .portrait-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .portrait {
    /* <Image> emits width and height attributes from the source file. Without
       height:auto those win, the frame renders at the source's own proportions
       and object-fit crops into the middle of the face. */
    height: auto;
    object-fit: cover;
  }

  .portrait-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--panel);
  }

  .portrait-frame .mono {
    font-size: 12px;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact a {
    font-family: var(--mono);
    font-size: 13px;
  }

  .contact-place {
    margin-top: 2px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .about-h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    line-height: 1.1;
  }

  .about-role {
    margin: 14px 0 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 66ch;
    margin-top: 32px;
  }

  .prose p {
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.1875rem);
    line-height: 1.65;
    color: var(--muted);
  }

  .prose .lead {
    color: var(--ink);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .principle h2 {
    font-size: 20px;
    line-height: 1.3;
  }

  .principle p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .hire-section {
    padding-bottom: 56px;
  }

  .hire-title {
    font-size: 28px;
    line-height: 1.25;
  }

  .hire-dek {
    max-width: 60ch;
    margin: 8px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }

  .hire-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .on-panel {
    background: var(--bg);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-block: 34px 32px;
    }

    .portrait,
    .portrait-frame {
      max-width: 280px;
    }

    .principles {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 32px;
    }

    .hire-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hire-actions .btn {
      justify-content: center;
      height: 52px;
      padding-block: 0;
    }
  }
</style>
