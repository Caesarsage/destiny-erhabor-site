---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { mailto, resumeUrl, selectedWork, socials } from '../data/site';

const description =
  'Destiny Erhabor builds cloud native systems and the documentation that makes them usable. Kubernetes v1.38 Docs Lead, CNCF Ambassador, and software and platform engineer at Oris.';

const github = socials.find((social) => social.label === 'GitHub')!;
const linkedin = socials.find((social) => social.label === 'LinkedIn')!;
---

<Base title="Destiny Erhabor" description={description}>
  <section class="wrap rail hero">
    <div class="hero-rail">
      <div class="rail-item">
        <div class="mono">Now</div>
        <p>Software and Platform Engineer at Oris</p>
      </div>
      <div class="rail-item">
        <div class="mono">Kubernetes</div>
        <p>Docs Lead, v1.38 release</p>
      </div>
      <div class="rail-item">
        <div class="mono">Elsewhere</div>
        <a class="rail-link" href={github.href}>{github.handle}</a>
        <a class="rail-link" href={linkedin.href}>{linkedin.handle}</a>
      </div>
    </div>

    <div class="hero-body">
      <h1 class="hero-h1">
        I build cloud native systems, and the documentation that makes them usable.
      </h1>

      <p class="dek hero-dek">
        Docs Lead for the Kubernetes v1.38 release, directing five shadows, and author of the
        rebuild that cut reference-documentation generation from hours to minutes. At Oris I lead
        architecture on payroll correctness, tenant isolation and service extraction for a platform
        serving more than ten thousand users.
      </p>

      <div class="chip-row hero-chips">
        <span class="chip">CNCF Ambassador</span>
        <span class="chip">Kubernetes v1.38 Docs Lead</span>
        <span class="chip">AWS Community Builder</span>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href={mailto}>
          Get in touch
          <Icon name="arrow" size={15} />
        </a>
        <a class="btn btn-ghost" href={resumeUrl}>
          Download resume
          <Icon name="download" size={14} />
        </a>
        <a class="hero-tertiary" href="#selected-work">See the work</a>
      </div>

      <p class="availability">
        <span class="dot"></span>
        <span>Open to software engineering, cloud native and developer relations roles</span>
      </p>
    </div>
  </section>

  <section class="wrap section" id="selected-work">
    <div class="band">
      <h2>Selected work</h2>
      <a class="band-link" href="/open-source/">Everything</a>
    </div>

    <div class="rows work-rows">
      {
        selectedWork.map((item, index) => (
          <article class="work">
            <div class="work-meta">
              <span class="work-index mono">{String(index + 1).padStart(2, '0')}</span>
              <span class="work-org mono">{item.org}</span>
            </div>
            <div class="work-body">
              <h3>{item.title}</h3>
              <p>{item.blurb}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 80px 72px;
  }

  .hero-rail {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding-top: 12px;
  }

  .rail-item {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .rail-item p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .rail-link {
    font-family: var(--mono);
    font-size: 13px;
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-chips {
    margin-top: 34px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    margin-top: 42px;
  }

  .hero-tertiary {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .hero-tertiary:hover {
    color: var(--ink);
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 26px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .band-link {
    font-family: var(--mono);
    font-size: 12px;
  }

  .work-rows {
    margin-top: 22px;
  }

  /* Index, body and organisation sit on one line each at desktop width and
     fold into a single "01 — Kubernetes" meta line on a phone. */
  .work {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) 190px;
    grid-template-areas: 'index body org';
    gap: 28px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }

  .work-rows > .work:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .work-meta {
    display: contents;
  }

  .work-index {
    grid-area: index;
    padding-top: 5px;
    font-size: 12px;
  }

  .work-org {
    grid-area: org;
    padding-top: 8px;
    text-transform: none;
    letter-spacing: 0;
  }

  .work-body {
    display: flex;
    grid-area: body;
    flex-direction: column;
    gap: 7px;
  }

  .work-body h3 {
    font-size: 23px;
    line-height: 1.25;
  }

  .work-body p {
    max-width: 72ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 34px 32px;
    }

    .hero-rail {
      gap: 18px;
      padding-top: 0;
    }

    .hero-chips {
      margin-top: 24px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      margin-top: 28px;
    }

    .hero-actions .btn {
      justify-content: center;
      height: 52px;
      padding-block: 0;
      font-size: 14px;
    }

    .hero-tertiary {
      padding-top: 6px;
      text-align: center;
    }

    .work {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'meta' 'body';
      gap: 7px;
      padding: 20px 0;
    }

    .work-meta {
      display: flex;
      grid-area: meta;
      gap: 8px;
    }

    .work-index::after {
      content: ' —';
    }

    .work-index,
    .work-org {
      padding-top: 0;
      font-size: 11px;
    }

    .work-body h3 {
      font-size: 21px;
    }

    .work-body p {
      font-size: 15px;
    }
  }
</style>
