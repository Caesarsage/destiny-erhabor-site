---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bullets from '../components/Bullets.astro';

const projects = await getCollection('projects');
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const kubernetes = projects.filter((p) => p.data.section === 'kubernetes').sort(byOrder);
const elsewhere = projects.filter((p) => p.data.section === 'elsewhere').sort(byOrder);

const description =
  'Kubernetes and Microcks: reference documentation tooling, the docs everyone reads, and contract testing moved into the inner loop.';

/** The one-off mentorship panel. Four labelled rows, in this order. */
const mentorship = [
  {
    label: 'Into the inner loop',
    text: 'Running a contract test previously cost a server, credentials and a specification import, so teams learned about breakages a pull request too late. It now runs against an ephemeral container with none of that.',
  },
  {
    label: 'Failures on the diff',
    text: 'Machine-readable output modes emit annotations resolved to the exact failing line of the specification, so a reviewer sees drift in place instead of hunting through folded CI logs.',
  },
  {
    label: 'Exit codes CI can trust',
    text: 'Failures are classified — usage, connection, API, not-found, environment — so a failing contract test reports as a result rather than a tool error.',
  },
  {
    label: 'Into the editor',
    text: 'A Microcks VS Code extension, deliberately CLI-first so the editor never becomes a second control plane and never handles credentials.',
  },
];
---

<Base title="Open source" description={description} active="/open-source/">
  <section class="wrap rail page-intro">
    <div class="mono rail-label">Open source</div>
    <div>
      <h1 class="page-h1">Two CNCF projects, and the tooling around them.</h1>
      <p class="dek">
        The through-line is the same one every time: find the step a human repeats every release,
        and delete it.
      </p>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Kubernetes</h2>
      <span class="meta">2025 — present</span>
    </div>

    <div class="rows">
      {
        kubernetes.map((project) => (
          <article class="row">
            <div class="rail-stack">
              <h3 class="entry-title">{project.data.title}</h3>
              <div class="meta">{project.data.meta ?? project.data.repo}</div>
              {project.data.current && <span class="badge">Current</span>}
            </div>

            <div class="entry-body">
              {project.data.heading && <h4 class="entry-heading">{project.data.heading}</h4>}
              {project.data.summary && <p class="entry-summary">{project.data.summary}</p>}
              {project.data.bullets.length > 0 && (
                <Bullets items={project.data.bullets} repo={project.data.repo} />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Microcks</h2>
      <span class="meta">CNCF incubating</span>
    </div>

    <div class="panel">
      <div class="mentorship-head">
        <div>
          <p class="eyebrow">
            <span class="dot"></span>
            LFX Mentorship 2026
          </p>
          <h3 class="mentorship-title">Microcks CLI v2</h3>
          <p class="mentorship-dek">
            Selected for the mentorship and mentored by the project's founder and maintainers.
          </p>
        </div>

        <div class="mentorship-facts">
          <div class="fact">
            <div class="mono">Term</div>
            <div class="fact-value">June — August 2026</div>
          </div>
          <div class="fact">
            <div class="mono">Repositories</div>
            <a class="fact-link" href="https://github.com/microcks/microcks-cli">
              microcks/microcks-cli
            </a>
            <a class="fact-link" href="https://github.com/Caesarsage/microcks-vscode">
              microcks-vscode
            </a>
            <a class="fact-link" href="https://github.com/orgs/microcks/discussions/2285">
              Adoption discussion
            </a>
          </div>
        </div>
      </div>

      <div class="mentorship-rows">
        {
          mentorship.map((item) => (
            <div class="mentorship-row">
              <div class="mentorship-label">{item.label}</div>
              <p class="mentorship-text">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap section elsewhere-section">
    <div class="section-head">
      <h2>Elsewhere</h2>
      <span class="meta">Side projects</span>
    </div>

    <div class="cards">
      {
        elsewhere.map((project) => (
          <article class="card">
            <div class="card-name">
              {project.data.url ? (
                <a href={project.data.url}>{project.data.title}</a>
              ) : (
                project.data.title
              )}
            </div>
            <h3 class="card-title">{project.data.heading}</h3>
            <p class="card-blurb">{project.data.blurb}</p>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .entry-title {
    font-size: 20px;
    line-height: 1.3;
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .entry-heading {
    font-size: 23px;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .entry-summary {
    max-width: 72ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .mentorship-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 56px;
    align-items: start;
  }

  .eyebrow {
    margin: 0;
  }

  .mentorship-title {
    margin-top: 16px;
    font-size: 32px;
    line-height: 1.16;
    letter-spacing: -0.018em;
  }

  .mentorship-dek {
    max-width: 62ch;
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.62;
    color: var(--muted);
  }

  .mentorship-facts {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .fact-value {
    font-size: 16px;
  }

  .fact-link {
    font-family: var(--mono);
    font-size: 13px;
  }

  .mentorship-rows {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 28px;
    padding-top: 26px;
    border-top: 1px solid var(--rule);
  }

  .mentorship-row {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 32px;
  }

  .mentorship-label {
    padding-top: 3px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink);
  }

  .mentorship-text {
    max-width: 68ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .card-name {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
  }

  .card-name a {
    color: inherit;
  }

  .card-title {
    font-size: 19px;
    line-height: 1.3;
  }

  .card-blurb {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .elsewhere-section {
    padding-bottom: 56px;
  }

  @media (max-width: 900px) {
    .mentorship-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .mentorship-rows {
      gap: 20px;
    }

    .mentorship-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .mentorship-label {
      padding-top: 0;
    }
  }
</style>
